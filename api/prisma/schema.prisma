// Schéma Prisma de l'API (étape 55)
// Migrations : npx prisma migrate dev --name <nom>  (développement)
//              npx prisma migrate deploy            (conteneur, au démarrage)

generator client {
  provider      = "prisma-client-js"
  // native : machine de développement ; linux-musl-openssl-3.0.x : image node:22-alpine
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Messages reçus par le formulaire de contact (étape 54)
model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
