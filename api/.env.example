# Variables d'environnement de l'API (exemple, aucun secret réel)
# Copier ce fichier en .env pour un usage local : cp .env.example .env
PORT=4000
HOST=0.0.0.0

# Origine(s) autorisée(s) par CORS (le portfolio Next.js), séparées par des virgules
CORS_ORIGIN=http://localhost:3000

# Connexion PostgreSQL utilisée par Prisma (étape 56)
# - en local sur la VM  : postgresql://amal:CHANGE_ME@localhost:5432/portfolio_db?schema=public
# - dans Docker Compose : postgresql://amal:CHANGE_ME@db:5432/portfolio_db?schema=public
DATABASE_URL=postgresql://amal:CHANGE_ME@localhost:5432/portfolio_db?schema=public

# Rate limiting de POST /api/contact : 5 requêtes / 15 minutes par adresse IP
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MS=900000
