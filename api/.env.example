# Variables d'environnement de l'API (exemple, aucun secret)
# Copier ce fichier en .env pour un usage local : cp .env.example .env
PORT=4000
HOST=0.0.0.0

# Connexion PostgreSQL (Prisma)
# - en local : postgresql://amal:password@localhost:5432/portfolio_db?schema=public
# - dans Docker Compose : postgresql://amal:password@db:5432/portfolio_db?schema=public
DATABASE_URL=postgresql://amal:password@localhost:5432/portfolio_db?schema=public
