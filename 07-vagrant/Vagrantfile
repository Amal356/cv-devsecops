# Étape 44 – Automatisation complète Vagrant + Ansible
Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.boot_timeout = 600

  config.vm.define "devsecops-vm" do |vm|
    vm.vm.hostname = "devsecops-vm"
    vm.vm.network "private_network", ip: "192.168.56.10"
    
    # Redirection de ports pour accès depuis Windows
    vm.vm.network "forwarded_port", guest: 3000, host: 3000
    vm.vm.network "forwarded_port", guest: 4000, host: 4000
    vm.vm.network "forwarded_port", guest: 5432, host: 5432

    vm.vm.provider "virtualbox" do |vb|
      vb.name = "devsecops-vm"
      vb.memory = 2048
      vb.cpus = 2
    end

    # Provisionnement Ansible automatique
    vm.vm.provision "ansible" do |ansible|
      ansible.playbook = "../ansible/deploy-fullstack.yml"
    end
  end
end
