# Variables lues par docker-compose.fullstack.yml (exemple, aucun secret réel)
# Copier ce fichier : cp .env.example .env   puis remplacer CHANGE_ME
# Le fichier .env n'est jamais versionné (.gitignore)

POSTGRES_USER=amal
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=portfolio_db

# Origine du navigateur autorisée par l'API (CORS) et adresse de l'API vue par le navigateur
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
